# Copy to .env.production on the server (never commit .env.production)
# cp .env.production.example .env.production

# --- Application ---
NODE_ENV=production
PORT=3000

# Email for trade-in notifications (logged today; wire SMTP later)
OWNER_EMAIL=info@fierauto.it

# --- Domain / SSL (used by deploy.sh) ---
DOMAIN=fierauto.it
CERTBOT_EMAIL=info@fierauto.it

# --- Optional HTTP Basic Auth for /admin (deploy.sh setup-auth) ---
# ADMIN_HTTP_USER=admin
# ADMIN_HTTP_PASSWORD=change-me-strong-password
