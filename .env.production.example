# Copy to .env.production on the server (never commit .env.production)
# cp .env.production.example .env.production

# --- Application ---
NODE_ENV=production
PORT=3000

# Admin authentication (change passwords before production)
ADMIN_INITIAL_PASSWORD=change-me-admin-strong
DEVELOPER_INITIAL_PASSWORD=change-me-dev-strong

# =============================================================================
# EMAIL — Form "Ritiriamo il tuo usato" (Libero Mail)
# Provider: smtp.libero.it
# Destinatario fisso richieste: fierauto2026@libero.it
#
# OBBLIGATORIO: SMTP_PASS (password casella Libero o password per app)
# SMTP_USER = username SMTP = indirizzo email completo
# =============================================================================
OWNER_EMAIL=fierauto2026@libero.it
SMTP_HOST=smtp.libero.it
SMTP_PORT=465
SMTP_USER=fierauto2026@libero.it
SMTP_PASS=INSERISCI_PASSWORD_CASELLA_LIBERO

# --- Domain / SSL (used by deploy.sh) ---
DOMAIN=fierauto.it
CERTBOT_EMAIL=info@fierauto.it

