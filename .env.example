# =============================================================================
# Fierauto — variabili ambiente
# =============================================================================
# Sviluppo locale:
#   cp .env.example .env.local
#   Compila SMTP_PASS (obbligatoria per il form permuta)
#
# Produzione (server):
#   cp .env.example .env.production
#   (oppure usa .env.production.example come riferimento)
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000

# =============================================================================
# EMAIL — Form "Ritiriamo il tuo usato"
# =============================================================================
# Provider configurato: Libero Mail (smtp.libero.it)
# Casella mittente/destinatario: fierauto2026@libero.it
#
# Variabili obbligatorie per l'invio email:
#   SMTP_PASS  → password della casella Libero
#
# Dove inserire username e password SMTP:
#   SMTP_USER  → indirizzo email completo (es. fierauto2026@libero.it)
#   SMTP_PASS  → password della casella (o "password per app" Libero)
#
# Variabili con valori predefiniti (modificare solo se necessario):
#   OWNER_EMAIL → destinatario richieste permuta (default: fierauto2026@libero.it)
#   SMTP_HOST   → server SMTP Libero (default: smtp.libero.it)
#   SMTP_PORT   → 465 SSL (alternativa Libero: 587 STARTTLS)
#   SMTP_USER   → account mittente (default: fierauto2026@libero.it)
# =============================================================================

OWNER_EMAIL=fierauto2026@libero.it
SMTP_HOST=smtp.libero.it
SMTP_PORT=465
SMTP_USER=fierauto2026@libero.it
SMTP_PASS=

# =============================================================================
# ADMIN — Pannello /admin (opzionale in locale, obbligatorio in produzione)
# =============================================================================
ADMIN_INITIAL_PASSWORD=change-me-admin-strong
DEVELOPER_INITIAL_PASSWORD=change-me-dev-strong

# =============================================================================
# DEPLOY — Solo server produzione
# =============================================================================
# DOMAIN=fierauto.it
# CERTBOT_EMAIL=info@fierauto.it
